# Ghidora - Local LLM Management Dashboard
# Copy this file to .env and configure your settings

# ===================
# DISCORD BOT (optional)
# ===================
DISCORD_TOKEN=your_discord_bot_token_here
# Get token from: https://discord.com/developers/applications
# 1. Create application → Bot tab → Add Bot → Copy token
# 2. Enable "Message Content Intent"
# 3. Invite bot using OAuth2 URL generator

# ===================
# FLASK CONFIGURATION
# ===================
FLASK_ENV=development
FLASK_DEBUG=True

# ===================
# SAFETY SETTINGS
# ===================
# Safe mode prevents autonomous file writes and git commits
SAFE_MODE=true
ALLOW_FILE_WRITE=false
ALLOW_GIT_COMMIT=false
ALLOW_TERMINAL=false

# ===================
# DATABASE
# ===================
DB_PATH=ghidora.db
CONVERSATIONS_FILE=conversations.json

# ===================
# GIT INTEGRATION
# ===================
GIT_ENABLED=false
GIT_REPO_PATH=/path/to/your/repo

# ===================
# AUTOMATION
# ===================
# Scheduler for cron-style jobs
SCHEDULER_ENABLED=false

# File watcher for auto-detecting changes
FILE_WATCHER_ENABLED=false
WATCH_DIRECTORY=/path/to/watch
